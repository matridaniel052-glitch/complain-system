# Copy this file to ".env" and fill in real values, then restart the app.
# ".env" holds real credentials and should never be committed/shared.

# --- Database (optional; defaults shown) ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=srccom_db

# --- Outgoing mail (complaint-response notifications) ---
# Example for Gmail: smtp.gmail.com, port 587, TLS on, and an App Password
# (not your normal Gmail password) generated at myaccount.google.com/apppasswords.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-address@gmail.com
